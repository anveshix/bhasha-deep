rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { 
      return request.auth != null; 
    }
    
    // Auth token contains email but no 'admin' claim explicitly unless set. 
    function isAdmin() { 
      // Bootstrap with the user email from runtime
      return isSignedIn() && request.auth.token.email == "pranav19feb87@gmail.com"; 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function isOwner() { 
      // Always test resource.data against auth uid
      return isSignedIn() && existing().user_id == request.auth.uid; 
    }

    // --- Validation Blueprints ---
    function isValidTranslation(data) {
      return data.keys().hasAll(['input_text', 'translated_text', 'source_lang', 'target_lang', 'timestamp', 'user_id', 'verified_dataset_match'])
        && data.keys().size() == 7
        && data.input_text is string && data.input_text.size() <= 50000
        && data.translated_text is string && data.translated_text.size() <= 100000
        && data.source_lang is string && data.source_lang.size() <= 50
        && data.target_lang is string && data.target_lang.size() <= 50
        && data.timestamp is number
        && data.user_id == request.auth.uid
        && data.verified_dataset_match is bool;
    }

    function isValidVoiceLog(data) {
      return data.keys().hasAll(['raw_text', 'processed_text', 'translated_text', 'user_id', 'timestamp'])
        && data.keys().size() == 5
        && data.raw_text is string && data.raw_text.size() <= 20000
        && data.processed_text is string && data.processed_text.size() <= 20000
        && data.translated_text is string && data.translated_text.size() <= 20000
        && data.timestamp is number
        && data.user_id == request.auth.uid;
    }

    function isValidSantaliDataset(data) {
      return data.keys().hasAll(['santali_text', 'hindi_text', 'confidence', 'source', 'timestamp'])
        && data.keys().size() == 5
        && data.santali_text is string && data.santali_text.size() <= 50000
        && data.hindi_text is string && data.hindi_text.size() <= 50000
        && data.confidence is number
        && data.source is string && data.source.size() <= 100
        && data.timestamp is number;
      // Missing user_id intentionally, because the dataset is public or admin-managed.
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['type', 'rating', 'text', 'input', 'user_id', 'timestamp'])
        && data.keys().size() == 6
        && data.type is string && data.type.size() <= 50
        && (data.rating == 'up' || data.rating == 'down' || data.rating == null || data.rating == '') 
        && data.text is string && data.text.size() <= 5000
        && data.input is string && data.input.size() <= 50000
        && data.timestamp is number
        && data.user_id == request.auth.uid;
    }

    function isValidFavorite(data) {
      // It can either be `{ user_id, entry_id, timestamp }` or `{ user_id, input, output, timestamp }`
      let isDictionaryFav = data.keys().hasAll(['user_id', 'entry_id', 'timestamp']) && data.keys().size() == 3;
      let isTranslationFav = data.keys().hasAll(['user_id', 'input', 'output', 'timestamp']) && data.keys().size() == 4;
      
      return (isDictionaryFav || isTranslationFav)
        && data.timestamp is number
        && data.user_id == request.auth.uid
        && (isDictionaryFav ? (data.entry_id is string && data.entry_id.size() <= 128) : true)
        && (isTranslationFav ? (data.input is string && data.input.size() <= 50000 && data.output is string && data.output.size() <= 100000) : true);
    }

    function isValidContribution(data) {
      return data.keys().hasAll(['santali_deva', 'roman_student', 'pos', 'hindi', 'contributed_by', 'timestamp'])
        && data.santali_deva is string && data.santali_deva.size() <= 5000
        && data.roman_student is string && data.roman_student.size() <= 5000
        && data.pos is string && data.pos.size() <= 100
        && data.hindi is string && data.hindi.size() <= 5000
        && data.contributed_by is string && data.contributed_by.size() <= 500
        && data.timestamp is number;
    }

    match /{document=**} { allow read, write: if false; }

    match /translations/{translationId} {
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow get: if isSignedIn() && (isOwner() || isAdmin());
      allow create: if isSignedIn() && isValidId(translationId) && isValidTranslation(incoming());
      allow update, delete: if isAdmin();
    }

    match /voice_logs/{logId} {
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow get: if isSignedIn() && (isOwner() || isAdmin());
      allow create: if isSignedIn() && isValidId(logId) && isValidVoiceLog(incoming());
      allow update, delete: if isAdmin();
    }

    match /santali_dataset/{dataId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(dataId) && isValidSantaliDataset(incoming());
      allow update, delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && isValidId(feedbackId) && isValidFeedback(incoming());
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /favorites/{favoriteId} {
      // User can create, read, and delete their own favorites
      allow create: if isSignedIn() && isValidId(favoriteId) && isValidFavorite(incoming());
      allow update: if (isAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['timestamp']) && isOwner() && isValidFavorite(incoming())));
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow get: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }

    match /contributions/{contributionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(contributionId) && isValidContribution(incoming());
      allow update, delete: if isAdmin();
    }

  }
}
