# GEMINI_API_KEY: server-side only. Used by the /api/gemini proxy in server.ts.
# It is NEVER sent to the browser and never bundled (see docs/SECURITY.md).
# Do not rename it to VITE_GEMINI_API_KEY: Vite inlines every VITE_* variable
# into public JavaScript.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: port the Express server binds to (default 3000).
PORT=3000

# APP_URL: public URL of this deployment (used for self-referential links).
APP_URL="MY_APP_URL"

# VITE_ALLOWED_HOSTS: extra comma-separated Host headers accepted by the dev
# server, e.g. "my-preview.example.com,staging.example.com".
# localhost, 127.0.0.1, *.e2b.app and *.github.dev are allowed already.
VITE_ALLOWED_HOSTS=""
